# Backend Dockerfile - Lightweight (no ML models, uses OpenAI API for embeddings)
FROM python:3.11-slim

WORKDIR /app

# Chromium via Playwright (Debian's /usr/bin/chromium crashes on arm64 Docker).
# xvfb supports headed browser mode when Cloudflare blocks headless automation.
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    xvfb \
    xauth \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ENV SCRAPER_HEADLESS=true

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install chromium

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
